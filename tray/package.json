{
  "name": "mad-for-audio-tray",
  "version": "1.1.0",
  "description": "Mad for Audio — 시스템 트레이(Windows)·메뉴바(macOS) 라디오 플레이어",
  "main": "main.js",
  "private": true,
  "author": "ducklove",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never",
    "dist:mac": "electron-builder --mac --arm64 --x64 --publish never",
    "check": "node --check main.js && node --check preload.js",
    "audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "electron": "43.1.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.madforaudio.tray",
    "productName": "Mad for Audio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "shell.html"
    ],
    "extraResources": [
      { "from": "../widget.html", "to": "web/widget.html" },
      { "from": "../turntable.html", "to": "web/turntable.html" },
      { "from": "../records.json", "to": "web/records.json" },
      { "from": "../stations.js", "to": "web/stations.js" },
      { "from": "../player-core.js", "to": "web/player-core.js" },
      { "from": "../icons", "to": "web/icons" }
    ],
    "win": {
      "target": ["nsis"],
      "artifactName": "MadForAudio-Setup-${version}-win-${arch}.${ext}",
      "icon": "../icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mad for Audio",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false,
      "installerLanguages": ["ko_KR", "en_US"]
    },
    "mac": {
      "target": ["dmg"],
      "artifactName": "MadForAudio-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "icon": "../icons/icon-512.png",
      "category": "public.app-category.music",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "dmg": {
      "title": "Mad for Audio ${version}",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    }
  }
}
